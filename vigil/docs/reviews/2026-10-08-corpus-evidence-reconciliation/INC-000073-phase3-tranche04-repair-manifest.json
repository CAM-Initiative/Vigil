  "old_to_new_crosswalk": [
    {
      "old_index": 0,
      "old_source_text": "Anthropic reports that Alibaba-linked operators used two pools of fraudulent accounts, residential proxies, disposable emails and virtual-card payments to access Opus models at high volume; after one pool was banned, traffic shifted to the second.",
      "new_index": 0,
      "episode_id": "E001"
    },
    {
      "old_index": 1,
      "old_source_text": "A fixed prompt elicited Opus reasoning traces inside the answers; Anthropic says its anti-distillation measures were targeted, but the report does not specify which operative safeguard applied to these requests or its state.",
      "new_index": 1,
      "episode_id": "E002"
    },
    {
      "old_index": 2,
      "old_source_text": "Anthropic says the extracted reasoning transcripts were saved, converted to supervised fine-tuning material and used to train Qwen models and develop other model capabilities.",
      "new_index": 2,
      "episode_id": "E003"
    },
    {
      "old_index": 3,
      "old_source_text": "Anthropic reports detecting and disrupting the campaigns, banning associated accounts and strengthening safeguards; the first Alibaba-linked pool’s ban did not prevent rapid use of the second pool.",
      "new_index": 3,
      "episode_id": "E004"
    }
  ],
