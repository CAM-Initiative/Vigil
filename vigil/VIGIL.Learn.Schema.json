{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.cam-initiative.org/schemas/vigil/VIGIL.Learn.Schema.json",
  "version": "0.1-exemplar",
  "title": "VIGIL LEARN Record Extension",
  "purpose": "Defines the VIGIL learning-closure record used to publish a completed evidence-to-repair chain as durable, searchable governance knowledge.",
  "authority_boundary": [
    "A LEARN record does not introduce, amend, or authoritatively classify a failure mode.",
    "Failure classification remains authoritative in the linked VIGIL Failure Mode record and the cited Caelestis failure taxonomy.",
    "Where a taxonomy class was absent or insufficient, the linked PATCH must establish or amend the Caelestis taxonomy before the LEARN record may describe that taxonomy status as established or refined.",
    "A LEARN record closes the evidence-to-repair chain by preserving the transferable lesson, its generalisation boundary, future application, taxonomy links, and report-section provenance."
  ],
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "record_type",
    "record_state",
    "date_recorded",
    "record_identity",
    "report_title",
    "case_descriptor",
    "summary",
    "abstracted_learning",
    "must_not_be_forgotten",
    "future_application",
    "generalisation_boundary",
    "failure_taxonomy_links",
    "learning_basis",
    "report_section_sources",
    "chain_completion",
    "knowledge_status",
    "publication_status",
    "linked_records",
    "interpretive_provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VIGIL-[0-9]{4}-LEARN-[0-9]{4}$"
    },
    "record_type": {
      "const": "learn"
    },
    "record_state": {
      "enum": [
        "draft",
        "active",
        "monitoring",
        "closed-actioned",
        "superseded"
      ]
    },
    "date_recorded": {
      "type": "string",
      "format": "date"
    },
    "record_identity": {
      "type": "object",
      "required": [
        "record_id",
        "record_type",
        "title",
        "created",
        "updated",
        "version"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^VIGIL-[0-9]{4}-LEARN-[0-9]{4}$"
        },
        "record_type": {
          "const": "learn"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report_title": {
      "type": "string",
      "minLength": 1
    },
    "case_descriptor": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "abstracted_learning": {
      "type": "string",
      "minLength": 1
    },
    "must_not_be_forgotten": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "future_application": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "generalisation_boundary": {
      "type": "string",
      "minLength": 1
    },
    "failure_taxonomy_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/failure_taxonomy_link"
      }
    },
    "learning_basis": {
      "type": "object",
      "required": [
        "primary_failure_mode",
        "proposal_records",
        "patch_records",
        "basis_statement"
      ],
      "properties": {
        "primary_failure_mode": {
          "type": "string",
          "pattern": "^VIGIL-[0-9]{4}-FM-[0-9]{4}$"
        },
        "proposal_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-PROP-[0-9]{4}$"
          }
        },
        "patch_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-PATCH-[0-9]{4}$"
          }
        },
        "basis_statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report_section_sources": {
      "type": "object",
      "required": [
        "section_01_observation",
        "section_02_record",
        "section_03_classification",
        "section_04_diagnosis",
        "section_05_repair",
        "section_06_learn"
      ],
      "properties": {
        "section_01_observation": {
          "$ref": "#/$defs/report_section_source"
        },
        "section_02_record": {
          "$ref": "#/$defs/report_section_source"
        },
        "section_03_classification": {
          "$ref": "#/$defs/report_section_source"
        },
        "section_04_diagnosis": {
          "$ref": "#/$defs/report_section_source"
        },
        "section_05_repair": {
          "$ref": "#/$defs/report_section_source"
        },
        "section_06_learn": {
          "$ref": "#/$defs/report_section_source"
        }
      }
    },
    "chain_completion": {
      "type": "object",
      "required": [
        "section_01_observation",
        "section_02_record",
        "section_03_classification",
        "section_04_diagnosis",
        "section_05_repair",
        "section_06_learn",
        "overall_status",
        "completion_basis"
      ],
      "properties": {
        "section_01_observation": {
          "const": "complete"
        },
        "section_02_record": {
          "const": "complete"
        },
        "section_03_classification": {
          "const": "complete"
        },
        "section_04_diagnosis": {
          "const": "complete"
        },
        "section_05_repair": {
          "const": "complete"
        },
        "section_06_learn": {
          "const": "complete"
        },
        "overall_status": {
          "const": "complete"
        },
        "completion_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "knowledge_status": {
      "enum": [
        "current",
        "under-review",
        "superseded"
      ]
    },
    "publication_status": {
      "enum": [
        "draft",
        "published",
        "withdrawn"
      ]
    },
    "linked_records": {
      "type": "object",
      "required": [
        "related_observations",
        "related_failure_modes",
        "related_proposals",
        "related_patch_notes",
        "related_learn_records",
        "research",
        "standards"
      ],
      "properties": {
        "related_observations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-OBS-[0-9]{4}$"
          }
        },
        "related_failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-FM-[0-9]{4}$"
          }
        },
        "related_proposals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-PROP-[0-9]{4}$"
          }
        },
        "related_patch_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-PATCH-[0-9]{4}$"
          }
        },
        "related_learn_records": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-LEARN-[0-9]{4}$"
          }
        },
        "research": {
          "type": "array"
        },
        "standards": {
          "type": "array"
        }
      }
    },
    "interpretive_provenance": {
      "type": "object",
      "minProperties": 1
    }
  },
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_taxonomy_link": {
      "type": "object",
      "required": [
        "failure_record_id",
        "primary_failure_family_code",
        "canonical_failure_name",
        "taxonomy_reference",
        "relationship",
        "taxonomy_status",
        "establishing_patch_id"
      ],
      "properties": {
        "failure_record_id": {
          "type": "string",
          "pattern": "^VIGIL-[0-9]{4}-FM-[0-9]{4}$"
        },
        "primary_failure_family_code": {
          "type": "string",
          "pattern": "^OPS\\.FF\\.[A-Z0-9_]+$"
        },
        "canonical_failure_name": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy_reference": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "const": "lesson-derived-from"
        },
        "taxonomy_status": {
          "enum": [
            "pre-existing-taxonomy-applied",
            "established-by-linked-patch",
            "refined-by-linked-patch",
            "crosswalk-added-by-linked-patch",
            "provisional-classification"
          ]
        },
        "establishing_patch_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^VIGIL-[0-9]{4}-PATCH-[0-9]{4}$"
        }
      }
    },
    "report_section_source": {
      "type": "object",
      "required": [
        "record_ids",
        "source_fields",
        "basis"
      ],
      "properties": {
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^VIGIL-[0-9]{4}-(OBS|FM|PROP|PATCH|RESEARCH|LEARN)-[0-9]{4}$"
          }
        },
        "source_fields": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
