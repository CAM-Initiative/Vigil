{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CAM-Initiative/Vigil/vigil/external_requirements/source-coverage-manifest.schema.json",
  "title": "VIGIL External Source Coverage Manifest",
  "description": "Generated Layer 1 source-version coverage manifest. 'bounded-complete' is an analytical scope claim, not proof that every source sentence or informative annex was decomposed.",
  "type": "object",
  "required": ["schema_version", "generated_at", "authorship_provenance", "source_version_count", "manifests"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "authorship_provenance": {"type": "object"},
    "source_version_count": {"type": "integer", "minimum": 0},
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["vigil_source_id", "external_source_id", "source_version", "coverage_state", "source_access_status", "source_retrieval_state", "analysis_state", "reviewed_sections", "reviewed_sections_status", "represented_requirement_count", "represented_clause_or_control_count", "expected_requirement_population", "known_unreviewed_sections", "inaccessible_sections", "completeness_criterion", "completeness_claim", "informative_material_treatment", "reviewed_source_digest_status", "reviewed_source_digests", "human_assurance_count", "assurance_limitations"],
        "properties": {
          "vigil_source_id": {"type": "string", "pattern": "^EXT-[A-F0-9]{12}$"},
          "external_source_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "coverage_state": {"enum": ["bounded-complete", "partial", "not-started", "blocked", "supporting-only", "context-only", "excluded", "superseded"]},
          "source_access_status": {"enum": ["direct-public-primary", "direct-licensed-primary", "official-public-extract", "official-metadata-only", "secondary-source-only", "source-unavailable"]},
          "source_retrieval_state": {"enum": ["retrieved", "not-retrieved", "not-established"]},
          "analysis_state": {"enum": ["not-started", "in-progress", "partial", "complete", "blocked-access", "supporting-only", "context-only", "excluded", "superseded-version"]},
          "reviewed_sections": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reviewed_sections_status": {"enum": ["enumerated", "not-enumerated"]},
          "represented_requirement_count": {"type": "integer", "minimum": 0},
          "represented_clause_or_control_count": {"type": "integer", "minimum": 0},
          "expected_requirement_population": {"type": ["integer", "null"], "minimum": 0},
          "known_unreviewed_sections": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "inaccessible_sections": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "completeness_criterion": {"type": "string", "minLength": 1},
          "completeness_claim": {"type": "string", "minLength": 1},
          "informative_material_treatment": {"type": "string", "minLength": 1},
          "reviewed_source_digest_status": {"enum": ["recorded", "not-recorded", "not-applicable"]},
          "reviewed_source_digests": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
          "human_assurance_count": {"type": "integer", "minimum": 0},
          "assurance_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
