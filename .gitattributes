# Non-substantive repository operations are retained in Git but omitted
# from Git archive-based source distributions (including tagged releases).
/.github/ export-ignore
/vigil/docs/design/ export-ignore
/vigil/migrations/completed/ export-ignore

# Non-research review plumbing is retained for open governance work but excluded
# from ZIP/TAR archive distributions; canonical records and substantive audits
# are deliberately NOT excluded by these patterns.
/AGENTS.md export-ignore
/vigil/AGENTS.md export-ignore
/vigil/docs/reviews/*handoff*.md export-ignore
/vigil/docs/reviews/*checkpoint*.md export-ignore
/vigil/docs/reviews/*-gate1*.md export-ignore
/vigil/docs/reviews/*-proposal.md export-ignore
/vigil/docs/reviews/*/FOLLOW-UP-PAYLOAD.md export-ignore
/vigil/docs/reviews/*/*-proposal.md export-ignore
/vigil/docs/reviews/*/*-gate1*.md export-ignore
