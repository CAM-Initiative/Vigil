{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CAM-Initiative/Vigil/vigil/external_requirements/effective-external-requirement.schema.json",
  "title": "VIGIL External AI-Governance Requirement — Effective Layer 1",
  "description": "Normalized Layer 1 analytical reference data derived from an authoritative external source. Normative-force and relationship fields classify the external source; they do not determine CAM applicability or assert compliance, conformance, alignment or implementation.",
  "type": "object",
  "required": ["requirement_id", "identity_key", "vigil_source_id", "external_source_id", "source_version", "canonical_source_identifier", "issuer", "jurisdiction", "source_class", "source_lifecycle_state", "source_role", "authoritative_locator", "clause_or_control", "parent_section_or_group", "source_access_status", "source_review_date", "source_access_notes", "requirement_summary", "requirement_posture", "expectation_type", "normative_force", "alignment_relationship", "applicable_actor", "governed_object", "lifecycle_stage", "governance_expectation", "evidence_expectation", "timing_or_frequency", "required_artefacts", "verification_method", "applicability_conditions", "exceptions_or_qualifications", "governance_concepts", "source_defined_tags", "related_external_requirements", "interpretation_status", "interpretation_provenance", "assurance_provenance", "review_limitations"],
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^EXTREQ-[A-F0-9]{16}$"},
    "identity_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "vigil_source_id": {"type": "string", "pattern": "^EXT-[A-F0-9]{12}$"},
    "external_source_id": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "canonical_source_identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {"scheme": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "issuer": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "source_class": {"type": "string", "minLength": 1},
    "source_lifecycle_state": {"type": "string", "minLength": 1},
    "source_role": {"enum": ["primary-ai-governance", "supporting-external-authority", "context-or-discovery", "excluded-from-current-scope"]},
    "authoritative_locator": {"type": "string", "format": "uri"},
    "clause_or_control": {"type": "string", "minLength": 1},
    "parent_section_or_group": {"type": ["string", "null"]},
    "source_access_status": {"enum": ["direct-public-primary", "direct-licensed-primary", "official-public-extract", "official-metadata-only", "secondary-source-only", "source-unavailable"]},
    "source_review_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_access_notes": {"type": "string", "minLength": 1},
    "requirement_summary": {"type": "string", "minLength": 1},
    "requirement_posture": {"enum": ["mandatory-normative", "recommended-practice", "permitted-optional", "definitional", "informative-guidance", "implementation-example", "conformity-evidence-expectation"]},
    "expectation_type": {"enum": ["positive-duty", "prohibition", "permission", "definition", "guidance", "implementation-example", "conformity-criterion", "right-or-protection"]},
    "normative_force": {
      "enum": ["binding-law", "regulatory-requirement", "contractual-or-incorporated-standard", "voluntary-consensus-standard", "voluntary-technical-specification", "informative-technical-report", "government-voluntary-framework", "industry-framework"],
      "description": "External source-level authority category. This is separate from requirement_posture and does not determine whether the source applies to CAM."
    },
    "alignment_relationship": {
      "enum": ["compliance", "conformance", "alignment", "reference-only"],
      "description": "Permitted downstream claim vocabulary if applicability/adoption is later established. This field is not a CAM applicability or satisfaction finding."
    },
    "applicable_actor": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "governed_object": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "lifecycle_stage": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["governance", "design", "development", "data-acquisition", "training", "testing-evaluation", "conformity-assessment", "placing-on-market", "deployment", "operation-use", "monitoring", "incident-response", "change-management", "retirement", "supply-chain", "cross-lifecycle", "not-specified"]}
    },
    "governance_expectation": {"type": "string", "minLength": 1},
    "evidence_expectation": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "timing_or_frequency": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_artefacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verification_method": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "applicability_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "exceptions_or_qualifications": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "governance_concepts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["accountability", "ai-literacy", "assurance", "change-management", "conformity", "data-governance", "documentation", "environmental-impact", "fairness-bias", "human-oversight", "impact-assessment", "incident-governance", "inventory", "lifecycle-governance", "monitoring", "privacy", "provenance", "risk-management", "robustness", "safety", "security", "supply-chain", "testing-evaluation", "traceability", "transparency", "worker-affected-person-rights"]}
    },
    "source_defined_tags": {
      "type": "array",
      "items": {
        "type": "object", "required": ["scheme", "values"],
        "properties": {"scheme": {"type": "string", "minLength": 1}, "values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
        "additionalProperties": false
      }
    },
    "related_external_requirements": {"type": "array", "items": {"type": "string", "pattern": "^EXTREQ-[A-F0-9]{16}$"}, "uniqueItems": true},
    "interpretation_status": {"enum": ["authoritative-direct", "reviewed-analytical-summary", "provisional-interpretation", "needs-specialist-review"]},
    "interpretation_provenance": {
      "type": "object",
      "required": ["basis", "content_origin", "generated_by", "generation_mode", "human_role", "human_authorship", "human_review_status", "human_verification_status", "source_analysis_method", "source_locator", "source_metadata_fingerprint", "reviewed_source_digest", "reviewed_source_digest_algorithm", "reviewed_source_digest_status"],
      "properties": {
        "basis": {"enum": ["direct-primary-text", "licensed-primary-text", "official-public-extract", "official-metadata-only", "secondary-source"]},
        "content_origin": {"const": "ai-authored"},
        "generated_by": {"const": "ai"},
        "generation_mode": {"const": "semi-autonomous"},
        "human_role": {"const": "contract-approver"},
        "human_authorship": {"const": false},
        "human_review_status": {"const": "not-reviewed"},
        "human_verification_status": {"const": "not-verified"},
        "source_analysis_method": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "source_metadata_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of VIGIL's material source-metadata projection; not a digest of the reviewed source artefact."},
        "reviewed_source_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "reviewed_source_digest_algorithm": {"enum": ["sha256", null]},
        "reviewed_source_digest_status": {"enum": ["recorded", "not-recorded", "not-applicable"]}
      },
      "additionalProperties": false
    },
    "assurance_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assurance_id", "human_role", "performed_by", "performed_at", "human_review_status", "human_verification_status", "scope", "method", "evidence_refs", "reviewed_source_digest", "limitations"],
        "properties": {
          "assurance_id": {"type": "string", "pattern": "^ASSURE-[A-F0-9]{16}$"},
          "human_role": {"enum": ["reviewer", "verifier"]},
          "performed_by": {"type": "string", "minLength": 1},
          "performed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "human_review_status": {"enum": ["not-reviewed", "spot-checked", "substantively-reviewed", "line-by-line-reviewed"]},
          "human_verification_status": {"enum": ["not-verified", "sample-verified", "source-verified", "fully-verified"]},
          "scope": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reviewed_source_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "review_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
