      "original_disposition": "mapped"
    },
    {
      "old_index": 3,
      "old_source_paraphrase": "OpenAI produced an incident notification on 10 September but sent it to a general public mailbox; Services Australia reported the matter to ASD's Australian Cyber Security Centre on 15 September.",
