{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VIGIL.FailureMode.Schema.json",
  "description": "Failure Mode records require structural classification, versioned severity and triage state, external ecosystem status, CAM repair status, implementation verification, and current-corpus coverage. Optional faceted failure analysis separates what failed from manifestation, cause, locus, observability, propagation, evidence state, and repair responsibility without forcing retrospective inference into legacy records. Model 2.0 triage remains strict.",
  "allOf": [
    {
      "$ref": "VIGIL.Base.Schema.json"
    },
    {
      "if": {
        "properties": {
          "triage": {
            "type": "object",
            "properties": {
              "model_version": {
                "const": "2.0"
              }
            },
            "required": [
              "model_version"
            ]
          }
        },
        "required": [
          "triage"
        ]
      },
      "then": {
        "properties": {
          "failure_classification": {
            "type": "object",
            "required": [
              "severity",
              "severity_assessment_basis"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "S0",
                  "S1",
                  "S2",
                  "S3",
                  "S4",
                  "SU"
                ]
              },
              "severity_assessment_basis": {
                "type": "string",
                "minLength": 1
              },
              "severity_assessment_gap": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "severity": {
                      "const": "SU"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                },
                "then": {
                  "required": [
                    "severity_assessment_gap"
                  ],
                  "properties": {
                    "severity_assessment_gap": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "triage": {
            "type": "object",
            "required": [
              "model_version",
              "triage_priority",
              "triage_owner",
              "triage_status",
              "triage_action_basis",
              "triage_review_date",
              "escalation_required",
              "recommended_next_step"
            ],
            "properties": {
              "model_version": {
                "const": "2.0"
              },
              "triage_priority": {
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3",
                  "PN",
                  "PU"
                ]
              },
              "triage_status": {
                "enum": [
                  "intake",
                  "under-assessment",
                  "action-required",
                  "repair-in-progress",
                  "verification-pending",
                  "monitoring",
                  "blocked",
                  "closed-actioned",
                  "closed-no-action",
                  "superseded"
                ]
              },
              "triage_owner": {
                "type": "string"
              },
              "triage_action_basis": {
                "type": "string"
              },
              "triage_review_date": {
                "type": "string"
              },
              "triage_assessment_gap": {
                "type": "string"
              },
              "escalation_required": {
                "type": "string"
              },
              "recommended_next_step": {
                "type": "string"
              },
              "active_escalation_trigger": {
                "type": "string"
              },
              "intervention_pathway": {
                "type": "string"
              },
              "urgent_condition": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "triage_priority": {
                      "enum": [
                        "P0",
                        "P1",
                        "P2",
                        "P3"
                      ]
                    }
                  },
                  "required": [
                    "triage_priority"
                  ]
                },
                "then": {
                  "properties": {
                    "recommended_next_step": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "triage_priority": {
                      "enum": [
                        "P0",
                        "P1"
                      ]
                    }
                  },
                  "required": [
                    "triage_priority"
                  ]
                },
                "then": {
                  "properties": {
                    "triage_owner": {
                      "type": "string",
                      "minLength": 1
                    },
                    "triage_action_basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "triage_review_date": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "triage_priority": {
                      "const": "P0"
                    }
                  },
                  "required": [
                    "triage_priority"
                  ]
                },
                "then": {
                  "properties": {
                    "escalation_required": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "triage_priority": {
                      "const": "PU"
                    }
                  },
                  "required": [
                    "triage_priority"
                  ]
                },
                "then": {
                  "required": [
                    "triage_assessment_gap"
                  ],
                  "properties": {
                    "triage_assessment_gap": {
                      "type": "string",
                      "minLength": 1
                    },
                    "recommended_next_step": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "triage_priority": {
                      "const": "PN"
                    }
                  },
                  "required": [
                    "triage_priority"
                  ]
                },
                "then": {
                  "properties": {
                    "triage_status": {
                      "not": {
                        "enum": [
                          "action-required",
                          "repair-in-progress",
                          "verification-pending"
                        ]
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "triage_status": {
                      "enum": [
                        "closed-actioned",
                        "closed-no-action",
                        "superseded"
                      ]
                    }
                  },
                  "required": [
                    "triage_status"
                  ]
                },
                "then": {
                  "properties": {
                    "triage_priority": {
                      "const": "PN"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "triage_status": {
                      "const": "monitoring"
                    },
                    "triage_priority": {
                      "enum": [
                        "P0",
                        "P1"
                      ]
                    }
                  },
                  "required": [
                    "triage_status",
                    "triage_priority"
                  ]
                },
                "then": {
                  "required": [
                    "active_escalation_trigger",
                    "intervention_pathway"
                  ],
                  "properties": {
                    "active_escalation_trigger": {
                      "type": "string",
                      "minLength": 1
                    },
                    "intervention_pathway": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "triage_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "from",
                "to",
                "reason",
                "action_basis",
                "trigger",
                "assessed_by",
                "next_review"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "enum": [
                    "P0",
                    "P1",
                    "P2",
                    "P3",
                    "PN",
                    "PU"
                  ]
                },
                "to": {
                  "enum": [
                    "P0",
                    "P1",
                    "P2",
                    "P3",
                    "PN",
                    "PU"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "action_basis": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger": {
                  "type": "string",
                  "minLength": 1
                },
                "assessed_by": {
                  "type": "string",
                  "minLength": 1
                },
                "next_review": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ],
  "properties": {
    "record_type": {
      "const": "failure_mode"
    },
    "failure_classification": {
      "type": "object",
      "required": [
        "failure_family",
        "canonical_failure_group",
        "taxonomy_reference",
        "related_failure_groups",
        "persistence",
        "reproducibility",
        "visibility"
      ],
      "properties": {
        "canonical_failure_group": {
          "enum": [
            "execution",
            "arbitration",
            "epistemic",
            "relational",
            "security-integrity",
            "state-context",
            "ux-representation",
            "governance",
            "infrastructure-continuity",
            "classification",
            "economic-legitimacy",
            "provisional"
          ]
        },
        "taxonomy_reference": {
          "type": "string"
        },
        "related_failure_groups": {
          "type": "array",
          "items": {
            "enum": [
              "execution",
              "arbitration",
              "epistemic",
              "relational",
              "security-integrity",
              "state-context",
              "ux-representation",
              "governance",
              "infrastructure-continuity",
              "classification",
              "economic-legitimacy",
              "provisional"
            ]
          }
        },
        "persistence": {
          "type": "string"
        },
        "reproducibility": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "faceted_analysis": {
          "type": "object",
          "description": "Optional structured reporting facets. These dimensions complement the canonical failure family and must not be treated as substitutes for severity, cause evidence, or taxonomy classification.",
          "required": [
            "schema_version",
            "event_state",
            "failure_locus",
            "observability",
            "evidence_state",
            "propagation"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "event_state": {
              "enum": [
                "anomaly",
                "hazard",
                "near-miss",
                "incident",
                "confirmed-failure",
                "unknown"
              ]
            },
            "manifestation": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "mechanism_or_cause": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "cause_status": {
              "enum": [
                "unknown",
                "hypothesised",
                "corroborated",
                "reproduced",
                "root-cause-confirmed",
                "not-applicable"
              ]
            },
            "failure_locus": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "model",
                  "harness",
                  "orchestration",
                  "agent-agent-interface",
                  "model-harness-interface",
                  "memory",
                  "retrieval",
                  "tool",
                  "tool-environment-interface",
                  "data-pipeline",
                  "provider-service",
                  "cross-provider-interface",
                  "user-interface",
                  "evaluator",
                  "human-workflow",
                  "external-environment",
                  "other",
                  "unknown"
                ]
              }
            },
            "repair_side": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "model",
                  "harness",
                  "orchestration",
                  "agent-agent-interface",
                  "model-harness-interface",
                  "memory",
                  "retrieval",
                  "tool",
                  "tool-environment-interface",
                  "data-pipeline",
                  "provider-service",
                  "cross-provider-interface",
                  "user-interface",
                  "evaluator",
                  "human-workflow",
                  "governance",
                  "multi-party",
                  "external-environment",
                  "other",
                  "unknown"
                ]
              }
            },
            "execution_phase": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "intake",
                  "planning",
                  "reasoning",
                  "delegation",
                  "retrieval",
                  "tool-selection",
                  "tool-execution",
                  "inter-agent-handoff",
                  "verification",
                  "completion-assessment",
                  "output-generation",
                  "post-processing",
                  "monitoring",
                  "change-management",
                  "unknown",
                  "not-applicable"
                ]
              }
            },
            "observability": {
              "enum": [
                "overt",
                "latent",
                "silent",
                "differentially-observable",
                "externally-detected",
                "user-reported",
                "unknown"
              ]
            },
            "evidence_state": {
              "enum": [
                "reported",
                "observed",
                "corroborated",
                "reproduced",
                "root-cause-confirmed",
                "provisional",
                "unknown"
              ]
            },
            "effect_or_harm": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "propagation": {
              "enum": [
                "local",
                "downstream",
                "cascading",
                "cross-provider",
                "systemic",
                "unknown"
              ]
            },
            "completion_state": {
              "enum": [
                "completed",
                "premature-termination",
                "non-termination",
                "false-completion",
                "unknown",
                "not-applicable"
              ]
            },
            "verification_state": {
              "enum": [
                "not-attempted",
                "incomplete",
                "incorrect",
                "passed",
                "failed",
                "unknown",
                "not-applicable"
              ]
            },
            "execution_pattern": {
              "enum": [
                "single-pass",
                "repeated-step",
                "looping",
                "retry-amplification",
                "degraded-but-functional",
                "unknown",
                "not-applicable"
              ]
            },
            "reporting_notes": {
              "type": "string"
            },
            "external_taxonomy_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "repair_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unrepaired",
            "partially-repaired",
            "repaired",
            "superseded",
            "not-actionable"
          ]
        },
        "repaired_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date_repaired": {
          "type": "string"
        },
        "verification_status": {
          "enum": [
            "corpus-verified",
            "external-adoption-unknown",
            "not-applicable",
            "observed-across-runtimes",
            "observed-in-one-runtime",
            "regression-detected",
            "unverified"
          ]
        },
        "monitoring_status": {
          "type": "string"
        },
        "verification_note": {
          "type": "string"
        },
        "repair_basis": {
          "enum": [
            "not-yet-established",
            "pre-existing-coverage-identified",
            "patch-implemented",
            "cross-domain-repair-assembled",
            "not-actionable",
            "superseded"
          ]
        },
        "remaining_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "repaired_by",
        "date_repaired",
        "verification_status",
        "monitoring_status",
        "repair_basis",
        "remaining_gaps"
      ]
    },
    "ecosystem_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "last_assessed",
        "monitoring_required"
      ],
      "properties": {
        "status": {
          "enum": [
            "active",
            "recurring",
            "improving",
            "externally-resolved",
            "unknown"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "last_assessed": {
          "type": "string",
          "minLength": 1
        },
        "monitoring_required": {
          "type": "boolean"
        }
      }
    },
    "corpus_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "corpus_repository",
        "corpus_ref",
        "corpus_commit",
        "assessed_date",
        "coverage_summary",
        "covered_by",
        "remaining_gaps"
      ],
      "properties": {
        "classification": {
          "enum": [
            "implemented-repair",
            "not-applicable",
            "no-confirmed-coverage",
            "partial-coverage",
            "retrospective-coverage",
            "verification-pending"
          ]
        },
        "corpus_repository": {
          "type": "string",
          "minLength": 1
        },
        "corpus_ref": {
          "type": "string",
          "minLength": 1
        },
        "corpus_commit": {
          "type": "string",
          "minLength": 1
        },
        "assessed_date": {
          "type": "string",
          "minLength": 1
        },
        "coverage_summary": {
          "type": "string",
          "minLength": 1
        },
        "covered_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instrument_id",
              "path",
              "sections",
              "coverage_type"
            ],
            "properties": {
              "instrument_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coverage_type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "remaining_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "triage": {
      "type": "object"
    }
  },
  "required": [
    "failure_mode_definition",
    "failure_threshold",
    "failure_classification",
    "triage",
    "repair_status",
    "ecosystem_status",
    "corpus_coverage"
  ],
  "not": {
    "required": [
      "source_data"
    ]
  }
}
