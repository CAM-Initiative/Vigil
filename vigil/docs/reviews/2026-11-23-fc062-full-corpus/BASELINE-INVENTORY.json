ion_on_record":"0.8.1","taxonomy_baseline":"0.9.2","existing_fc062_mappings":[],"relevant_existing_fc062_clause_relationships":[],"potential_newly_engaged_episodes":[],"screening_status":"not_screened","proposed_disposition":"pending_source_first_screen","recognition_condition_findings":null,"exclusion_findings":null,"competing_classes":[],"evidence_limitations":[],"canonical_edit_status":"not_needed_at_baseline","source_references":[],"prior_review_history":null},{"incident_id":"VIGIL-INC-000201","record_path":"vigil/records/incidents/VIGIL-INC-000201.json","taxonomy_version_on_record":"0.9.1","taxonomy_baseline":"0.9.2","existing_fc062_mappings":[{"location":"secondary","family_id":"VIGIL-FF-0003","class_id":"VIGIL-FC-000062","classification_role":"failure-occurrence","classification_confidence":"high","classification_basis":"The AIOpsDoom study describes a concrete agent adopting an attacker-planted false SSL diagnosis and repair direction from application telemetry, then executing the repair in the SocialNet example. The operational task required a factually grounded diagnosis; attacker-controlled telemetry was treated as adequate without the assurance needed for that task. The tested AIOpsShield rerun is retained as a separate successful protection.","boundary_adjudication":null}],"relevant_existing_fc062_clause_relationships":[{"episode_id":"E002","clause_index":1,"source_record_refs":["source_records[0]"],"canonical_taxonomy_mapping":null,"adjudication_status":"mapped","relationships":[{"class_id":"VIGIL-FC-000062","relationship":"failure-occurrence","canonical_taxonomy_mapping":true,"rationale":"The GPT-4o Flash agent accepted the false diagnosis and repair as actionable and executed it in the reported SocialNet example. This was an operational repair task, so the inaccurate evidence was unfit for that stage despite the controlled research setting."}]}],"potential_newly_engaged_episodes":[],"screening_status":"not_screened","proposed_disposition":"pending_source_first_screen","recognition_condition_findings":null,"exclusion_findings":null,"competing_classes":[],"evidence_limitations":[],"canonical_edit_status":"not_needed_at_baseline","source_references":["source_records[0]"],"prior_review_history":null},{"incident_id":"VIGIL-INC-000202","record_path":"vigil/records/incidents/VIGIL-INC-000202.json","taxonomy_version_on_record":"0.8.1","taxonomy_baseline":"0.9.2","existing_fc062_mappings":[{"location":"primary","family_id":"VIGIL-FF-0003","class_id":"VIGIL-FC-000062","classification_role":"failure-occurrence","classification_confidence":"medium","classification_basis":"AI-generated drivers called internal functions outside valid calling conditions. The resulting crash artefacts were treated as program-error evidence even though later context validation identified additional driver errors. The crash was real in the constructed harness, but its interpretation as a reachable application defect lacked the assurance required for defect triage.","boundary_adjudication":null}],"relevant_existing_fc062_clause_relationships":[{"episode_id":"E001","clause_index":0,"source_record_refs":["source_records[0]"],"canonical_taxonomy_mapping":null,"adjudication_status":"mapped","relationships":[{"class_id":"VIGIL-FC-000062","relationship":"failure-occurrence","canonical_taxonomy_mapping":true,"rationale":"The generated driver supplied arbitrary bytes where the target function expected a valid image object. A crash under that invalid calling condition establishes that the constructed test crashed, not that normal application use can trigger the same fault. The evaluated workflow still labelled some such outcomes as program errors until a later validator examined their calling context. Treating the crash as application-defect evidence before establishing that connection gave the test artefact more diagnostic assurance than it supported."}]},{"episode_id":"E003","clause_index":2,"source_record_refs":["source_records[0]"],"canonical_taxonomy