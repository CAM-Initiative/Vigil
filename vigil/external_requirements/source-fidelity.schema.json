{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CAM-Initiative/Vigil/vigil/external_requirements/source-fidelity.schema.json",
  "title": "VIGIL External Requirement Source Fidelity Ledger",
  "type": "object",
  "required": ["schema_version", "reviewed_at", "policy", "entries"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "policy": {
      "type": "object",
      "required": ["unlisted_complete_source_fidelity", "effective_completion_rule"],
      "properties": {
        "unlisted_complete_source_fidelity": {"const": "fidelity-unassured"},
        "effective_completion_rule": {"const": "extraction-complete-and-fidelity-assured"}
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vigil_source_id",
          "external_source_id",
          "source_version",
          "fidelity_status",
          "effective_extraction_status",
          "assessment_basis",
          "known_fidelity_gaps",
          "next_action"
        ],
        "properties": {
          "vigil_source_id": {"type": "string", "pattern": "^EXT-[A-F0-9]{12}$"},
          "external_source_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "fidelity_status": {
            "enum": ["assured", "provisional", "requires-reextraction", "blocked", "not-applicable"]
          },
          "effective_extraction_status": {
            "enum": ["complete", "partial", "blocked-access", "supporting-only", "context-only", "superseded-version"]
          },
          "assessment_basis": {"type": "string", "minLength": 1},
          "known_fidelity_gaps": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "audited_requirement_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^EXTREQ-[A-F0-9]{16}$"},
            "uniqueItems": true
          },
          "next_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
